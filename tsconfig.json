{
  "extends": "@salesforce/dev-config/tsconfig-strict",
  "compilerOptions": {
    "outDir": "./lib",
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "rootDir": "./src",
    "plugins": [{ "transform": "./src/messageTransformer.ts", "tsConfig": "./tsconfig.transformer.json" }],
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["./src/**/*.ts"]
}
